[Unit]
Description=VNPT lead notification outbox worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=vnpt-notify
Group=vnpt-notify
EnvironmentFile=/etc/vnpt-notifications.env
ExecStart=/usr/bin/python3 /opt/vnpt-notify/notification-worker.py
TimeoutStartSec=110
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
UMask=0077
MemoryMax=128M
